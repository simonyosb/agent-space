{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSpace",
  "version": "0.1.0",
  "identifier": "co.realfactory.agentspace",
  "build": {
    "beforeDevCommand": "bun run build:fleet-bins && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:sidecars && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentSpace",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/fleet-msg",
      "binaries/fleet-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDMUFFODA2RkU4QkIwNTAKUldSUXNJditCdWdhakdZN0Y5c1M5V0duOGIzOVI5UHFpU3NMdkxrdHlkWGN5S012dG93ZDBUTnQK",
      "endpoints": [
        "https://github.com/simonyos/agent-space/releases/latest/download/latest.json"
      ]
    }
  }
}
